# Environment: staging or production
NEXT_PUBLIC_FORM_ENV=staging

# General forms (Enquiry & Exit popup)
NEXT_PUBLIC_FORM_STAGING_URL=https://staging.myformcapture.com/f/your-staging-uuid
NEXT_PUBLIC_FORM_PRODUCTION_URL=https://myformcapture.com/f/your-production-uuid

# Scheduling form (Booking modal)
NEXT_PUBLIC_SCHEDULING_STAGING_URL=https://staging.myformcapture.com/f/your-scheduling-staging-uuid
NEXT_PUBLIC_SCHEDULING_PRODUCTION_URL=https://myformcapture.com/f/your-scheduling-production-uuid

# Optional custom forms
# NEXT_PUBLIC_CONTACT_STAGING_URL=
# NEXT_PUBLIC_CONTACT_PRODUCTION_URL=
# NEXT_PUBLIC_NEWSLETTER_STAGING_URL=
# NEXT_PUBLIC_NEWSLETTER_PRODUCTION_URL=

# Optional external booking link (Calendly, Cal.com)
# NEXT_PUBLIC_BOOKING_URL=

# Optional legacy overrides
# NEXT_PUBLIC_MYFORMCAPTURE_ENDPOINT=
# NEXT_PUBLIC_MYFORMCAPTURE_FORM_ID=
